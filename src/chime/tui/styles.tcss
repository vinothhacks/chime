Screen {
    background: #1a1b26;
    color: #c0caf5;
}

Header {
    background: #16161e;
    color: #7aa2f7;
    text-style: bold;
}

Footer {
    background: #16161e;
}

#hero {
    height: auto;
    padding: 1 2;
    align: center middle;
}

#clock {
    width: 100%;
    text-align: center;
    color: #7aa2f7;
    padding: 0 1;
}

#date-line {
    text-align: center;
    color: #a9b1d6;
}

#next {
    text-align: center;
    color: #9ece6a;
    padding: 1 0;
}

#alarms {
    height: 1fr;
    border: tall #3b4261;
    margin: 0 2 1 2;
    background: #16161e;
}

#alarms > .list-item--highlight {
    background: #292e42;
    border: tall #7aa2f7;
}

AlarmRow {
    layout: horizontal;
    height: 1;
    padding: 0 1;
}

AlarmRow .time {
    width: 10;
    color: #c0caf5;
    text-style: bold;
}

AlarmRow .days {
    width: 16;
    color: #a9b1d6;
}

AlarmRow .label {
    width: 1fr;
}

AlarmRow .state-on {
    width: 6;
    color: #9ece6a;
    text-style: bold;
}

AlarmRow .state-off {
    width: 6;
    color: #bb9af7;
}

#footer-help {
    dock: bottom;
    height: 1;
    color: #565f89;
    padding: 0 2;
}

RingingScreen {
    align: center middle;
}

#ring-box {
    width: 48;
    height: auto;
    border: tall #f7768e;
    background: #16161e;
    padding: 2 3;
}

#ring-box.pulse {
    border: tall #e0af68;
}

#ring-title {
    text-align: center;
    color: #f7768e;
    text-style: bold;
}

#ring-time {
    text-align: center;
    color: #c0caf5;
    text-style: bold;
    padding: 1 0;
}

#ring-label {
    text-align: center;
    color: #7aa2f7;
}

#ring-elapsed {
    text-align: center;
    color: #a9b1d6;
    padding: 1 0;
}

#ring-keys {
    text-align: center;
    color: #9ece6a;
}

EditAlarmScreen {
    align: center middle;
}

#edit-box {
    width: 60;
    height: auto;
    max-height: 90%;
    border: tall #7aa2f7;
    background: #16161e;
    padding: 1 2;
    overflow-y: auto;
}

#edit-error {
    color: #f7768e;
    height: auto;
}

HelpScreen {
    align: center middle;
}

#help-box {
    width: 56;
    height: auto;
    border: tall #7aa2f7;
    background: #16161e;
    padding: 1 2;
}

ConfirmScreen {
    align: center middle;
}

#confirm-box {
    width: 48;
    height: auto;
    border: tall #e0af68;
    background: #16161e;
    padding: 1 2;
}

Input {
    background: #24283b;
    border: tall #3b4261;
}

Input:focus {
    border: tall #7aa2f7;
}
